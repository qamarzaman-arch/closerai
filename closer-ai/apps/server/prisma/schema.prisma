datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id                String         @id @default(uuid())
  full_name         String
  phone_number      String
  email             String?
  linkedin_url      String?
  property_address  String?
  property_type     String?
  estimated_value   Float?
  seller_motivation String?
  motivation_tags   String?
  deal_score        Float?         @default(0)
  notes             String?
  tags              String?
  call_status       String         @default("NEW")
  follow_up_date    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          CallSession[]
  noteHistory       Note[]

  @@index([phone_number])
  @@index([full_name])
  @@index([call_status])
}

model CallSession {
  id                 String         @id @default(uuid())
  leadId             String
  lead               Lead           @relation(fields: [leadId], references: [id])
  startTime          DateTime       @default(now())
  endTime            DateTime?
  duration           Int?
  outcome            String?
  predicted_outcome  String?
  seller_personality String?
  urgency_level      Int?
  deal_probability   Float?
  motivation_detected String?
  transcript         Transcript?
  suggestions        AISuggestion[]
  objections         Objection[]
  createdAt          DateTime       @default(now())

  @@index([leadId])
  @@index([createdAt])
}

model Transcript {
  id            String      @id @default(uuid())
  sessionId     String      @unique
  session       CallSession @relation(fields: [sessionId], references: [id])
  content       String
  jsonContent   String
  createdAt     DateTime    @default(now())
}

model AISuggestion {
  id            String      @id @default(uuid())
  sessionId     String
  session       CallSession @relation(fields: [sessionId], references: [id])
  prompt        String
  response      String
  style         String?
  wasUsed       Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([sessionId])
}

model Objection {
  id                  String      @id @default(uuid())
  sessionId           String
  session             CallSession @relation(fields: [sessionId], references: [id])
  type                String
  text                String
  rebuttal_soft       String?
  rebuttal_firm       String?
  rebuttal_aggressive String?
  rebuttal_empathy    String?
  createdAt           DateTime    @default(now())

  @@index([sessionId])
}

model Note {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([leadId])
}
