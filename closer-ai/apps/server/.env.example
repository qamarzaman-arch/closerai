DATABASE_URL="mysql://root:@localhost:3306/closer_ai"

# Chat/suggestions — can be an OpenRouter key pointing to any model
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="openai/gpt-4o-mini"
OPENROUTER_SITE_URL="http://localhost:5173"
OPENROUTER_APP_NAME="CloserAI"

# Whisper transcription — OpenRouter keys DO NOT work for audio/transcriptions.
# Option A (recommended, free): Groq Whisper — get key at console.groq.com
GROQ_API_KEY=""
# Option B: Real OpenAI key — WHISPER_API_KEY overrides OPENAI_API_KEY for transcription only
WHISPER_API_KEY=""
