DATABASE_URL="mysql://root:@localhost:3306/closer_ai"

# Chat/suggestions — can be an OpenRouter key pointing to any model
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="openai/gpt-4o-mini"
OPENROUTER_SITE_URL="http://localhost:5173"
OPENROUTER_APP_NAME="CloserAI"

# Whisper transcription — MUST be a real OpenAI key (openrouter does not support audio/transcriptions)
# WHISPER_API_KEY defaults to OPENAI_API_KEY if not set.
# WHISPER_BASE_URL defaults to https://api.openai.com/v1 (do not point this at OpenRouter).
WHISPER_API_KEY=""
